<UserControl x:Class="Garajim.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
