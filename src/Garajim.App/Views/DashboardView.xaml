<UserControl x:Class="Garajim.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Garajim.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Ana Sayfa" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{Binding SelectedVehicleText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="4">
            <controls:StatCard Title="Toplam araç gideri" Value="{Binding TotalExpenseText}" Subtitle="Tüm zamanlar" />
            <controls:StatCard Title="Aylık yakıt gideri" Value="{Binding MonthlyFuelText}" Subtitle="Bu ay" />
            <controls:StatCard Title="Ortalama tüketim" Value="{Binding AverageConsumptionText}" Subtitle="Tam depo yöntemi" />
            <controls:StatCard Title="Kilometre başına maliyet" Value="{Binding CostPerKmText}" Subtitle="Yakıt" />
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,16,0" Padding="20" CornerRadius="12" BorderThickness="1"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}">
                <StackPanel>
                    <TextBlock Text="Son bakım kayıtları" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Bakım modülü eklenince burada listelenecek." Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="20" CornerRadius="12" BorderThickness="1"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}">
                <StackPanel>
                    <TextBlock Text="Yaklaşan tarihler" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Muayene, sigorta ve bakım hatırlatmaları burada görünecek." Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
