<UserControl x:Class="Garajim.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Garajim.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Ana Sayfa" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="{Binding HeaderText}" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="15" Margin="0,6,0,0" />
            <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Araç seçimi -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <StackPanel Visibility="{Binding HasVehicles, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Araç seç" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                <ListBox Style="{StaticResource ChipListBox}"
                         ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <TextBlock Text="Henüz araç yok. Soldaki Araçlar sayfasından ilk aracını ekle."
                       Style="{StaticResource CaptionText}" FontSize="13"
                       Visibility="{Binding HasNoVehicles, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,-16,0">
            <controls:StatCard Title="Toplam araç gideri" Value="{Binding TotalExpenseText}" Subtitle="Henüz kayıt yok" />
            <controls:StatCard Title="Aylık yakıt gideri" Value="{Binding MonthlyFuelText}" Subtitle="Henüz kayıt yok" />
            <controls:StatCard Title="Ortalama tüketim" Value="{Binding AverageConsumptionText}" Subtitle="Henüz kayıt yok" />
            <controls:StatCard Title="Kilometre başına maliyet" Value="{Binding CostPerKmText}" Subtitle="Henüz kayıt yok" />
        </UniformGrid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,16,0" Padding="20" CornerRadius="12" BorderThickness="1"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}">
                <StackPanel>
                    <TextBlock Text="Son bakım kayıtları" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Bakım modülü eklenince burada listelenecek." Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="20" CornerRadius="12" BorderThickness="1"
                    Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}">
                <StackPanel>
                    <TextBlock Text="Yaklaşan tarihler" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="Muayene, sigorta ve bakım hatırlatmaları burada görünecek." Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
